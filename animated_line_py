import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

# Create figure and axis
fig, ax = plt.subplots()
ax.set_xlim(0, 10)
ax.set_ylim(0, 5)

# Create a horizontal line (initially at y = 2.5)
line, = ax.plot([0, 10], [2.5, 2.5], color='red', linewidth=3)

# Animation function
def update(frame):
    y = 2.5 + 0.5 * np.sin(frame * 0.1)  # smooth vertical movement
    line.set_ydata([y, y])
    return line,

# Create animation
ani = FuncAnimation(fig, update, frames=200, interval=30, blit=True)

plt.title("Animated Line")
plt.show()

